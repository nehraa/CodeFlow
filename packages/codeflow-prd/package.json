{
  "name": "@abhinav2203/codeflow-prd",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./build": { "types": "./dist/build/index.d.ts", "default": "./dist/build/index.js" }
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "vitest run",
