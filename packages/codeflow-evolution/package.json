{
  "name": "@abhinav2203/codeflow-evolution",
  "version": "0.1.0",
  "private": false,
  "description": "Genetic algorithm for architecture evolution with AI-powered ghost nodes",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ghost": {
      "types": "./dist/ghost/index.d.ts",
      "default": "./dist/ghost/index.js"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "default": "./dist/providers/index.js"
    }
  },
  "bin": {
    "codeflow-evolution": "./dist/bin/cli.js"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc --build && node scripts/wrap-cli.mjs",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@abhinav2203/codeflow-core": "^1.1.6",
    "dotenv": "^16.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}